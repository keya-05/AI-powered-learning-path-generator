DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/learning_path_db
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

CHROMA_PERSIST_DIR=./chroma_data
STORAGE_ROOT=./uploaded_resources
MAX_UPLOAD_SIZE_MB=25

# AI features: LLM_PROVIDER is "gemini" or "anthropic"
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Only used when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
